# =============================================================================
# AI Profit OS · Phase0 `.env` 템플릿 (SSOT)
# =============================================================================
# 1) 이 파일을 복사:  cp .env.example .env
# 2) YOUR_* / change_me_* 만 실값으로 교체
# 3) `.env`는 Git 커밋 금지 · GitHub/채팅 붙여넣기 금지
# 4) 커밋 전: pnpm verify:secrets
#
# Nest(api-nest)가 읽는 SSOT: services/api-nest/src/config/phase0.env.ts
# CF Workers 시세 adapter 키 = Worker secrets + 아래 .env 병행(로컬 Nest ingest용)
# =============================================================================


# ─── 0) 로컬 런타임 (8GB Celeron 기본) ───────────────────────────────────────
NODE_ENV=development
# Celeron 2C / 8GB — RAM 여유 없으면 1536 유지 (2048=OOM 위험)
NODE_OPTIONS=--max-old-space-size=1536
PORT=4000

ROOT_DOMAIN=localhost
APP_HOST=localhost:3000
OPS_HOST=localhost:3001
API_HOST=localhost:4000
# GO_HOST=go.your-domain.com

# Production 배포 시 (hiptk.app · ADR-010)
# ROOT_DOMAIN=hiptk.app
# APP_HOST=app.hiptk.app
# OPS_HOST=ops.hiptk.app
# API_HOST=api.hiptk.app
# GO_HOST=go.hiptk.app


# ─── 1) Supabase PostgreSQL (Seoul · DB only · Auth=Nest JWT) ───────────────
# User Auth = api-nest JWT (ADR-006) — Supabase Auth 병행 금지
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_REGION=ap-northeast-2

# Dashboard → Settings → API (anon — web 클라이언트용 · RLS 아님 SoT)
SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Dashboard → Settings → Database → URI (pooler · Seoul)
DATABASE_URL=postgresql://postgres.your-ref:YOUR_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# Nest server-only (never NEXT_PUBLIC) — Dashboard → API → service_role
# SUPABASE_SERVICE_ROLE=your-service-role-jwt


# ─── 2) Redis (Upstash hot cache · Twin/Memory/LLM quota) ───────────────────
# Upstash Console → Redis → Connect → Redis URL 만 (.env 에만)
# redis-cli 전체 명령 붙여넣기 금지
REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@YOUR-ENDPOINT.upstash.io:6379


# ─── 3) JWT (Nest · 유저/어드민 분리) ───────────────────────────────────────
JWT_USER_SECRET=change_me_user_min_32_chars
JWT_ADMIN_SECRET=change_me_admin_min_32_chars


# ─── 4) OAuth (Kakao primary · Google secondary) ────────────────────────────
# Nest server secrets (founder .env) — never commit real values
OAUTH_KAKAO_CLIENT_ID=YOUR_KAKAO_REST_API_KEY
OAUTH_KAKAO_CLIENT_SECRET=YOUR_KAKAO_CLIENT_SECRET
OAUTH_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
OAUTH_GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# UI guest surfaces (apps/web) — keep 0 until Infra auth-kakao-oauth-runtime
# ships callback. Client id alone must NOT enable Kakao CTA (disabled guard).
NEXT_PUBLIC_OAUTH_KAKAO_ENABLED=0


# ─── 5) Cloudflare (배포 · Workers/Pages/R2) ────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
# 로컬 대안: pnpm cf:login (OAuth · 토큰 없이 wrangler 세션)

# R2 — KYC private (Money §42)
R2_KYC_BUCKET=kyc-docs
# R2 — Asset Master public images (Engine §0.0.6)
R2_ASSET_IMAGES_BUCKET=asset-images
# R2_ASSET_IMAGES_PUBLIC_BASE=https://assets.your-domain.com
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_KYC_ENCRYPTION_KEY=


# ─── 6) Email (Resend · magic link · withdraw OTP) ──────────────────────────
# RESEND_API_KEY=YOUR_RESEND_KEY
# RESEND_FROM_EMAIL=noreply@your-verified-domain.com


# ─── 7) 퍼뜩 LLM Adapter (Engine §47.13~15 · Nest only · NEXT_PUBLIC 0) ───
#
# ★ provider는 한 번에 1개만 (자동 failover Day-1 금지)
# ★ Admin UI 모델 선택 없음 — 아래 LLM_PROVIDER 만 변경
# ★ Ollama = 로컬 옵션 · 8GB PC 비권장 (삭제해도 OK · LLM_PROVIDER≠ollama 이면 무관)
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │ RECIPE A — 외부 LLM 없음 (개발·Fact/템플릿만 · G=busy)                    │
# │   LLM_PROVIDER=none                                                     │
# │   (GEMINI/OpenAI 키 없어도 P레인 Fact 테스트 가능)                        │
# └─────────────────────────────────────────────────────────────────────────┘
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │ RECIPE B — Day-1 클라우드 기본 (무료 · 권장)                              │
# │   LLM_PROVIDER=gemini_free                                              │
# │   GEMINI_API_KEY=...  ← https://aistudio.google.com/apikey              │
# │   GEMINI_MODEL=gemini-flash-lite-latest                                 │
# └─────────────────────────────────────────────────────────────────────────┘
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │ RECIPE C — OpenAI (Eval PASS 후 Prod · 유료)                            │
# │   LLM_PROVIDER=openai                                                   │
# │   LLM_API_KEY=sk-...                                                    │
# │   OPENAI_MODEL=gpt-4o-mini                                              │
# └─────────────────────────────────────────────────────────────────────────┘
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │ RECIPE D — Groq (대체·속도 · gemini 장애 시 수동 전환)                   │
# │   LLM_PROVIDER=groq                                                     │
# │   LLM_API_KEY=gsk_...                                                   │
# │   GROQ_MODEL=llama-3.1-8b-instant                                       │
# └─────────────────────────────────────────────────────────────────────────┘

LLM_PROVIDER=none

# --- gemini_free (RECIPE B) ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-flash-lite-latest

# --- openai / groq 공용 슬롯 (RECIPE C/D) ---
# LLM_API_KEY=YOUR_OPENAI_OR_GROQ_KEY
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.1-8b-instant

# --- ollama (RECIPE E · 로컬 · 8GB 비권장 · 프로그램 없어도 OK) ---
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# --- openai compat base override (ollama/groq/proxy) ---
# LLM_BASE_URL=

# Soft quota (Redis · 초과 시 G=PEOTTEOK_LLM_BUSY · P=Fact 유지)
LLM_QUOTA_SOFT_RPM=10
LLM_QUOTA_SOFT_RPD=200

# 퍼뜩 Coach conversation working-state (Engine §47.16.2 · Redis only · PO-locked 2026-08-12)
# Sliding TTL — 매 턴 갱신되지만 절대 상한(아래)을 넘기지 않음
AI_CONV_STATE_TTL_SEC=3600
# Absolute lifetime cap — sliding 갱신이 있어도 createdAt+12h를 초과해 연장하지 않음
AI_CONV_STATE_ABSOLUTE_LIFETIME_SEC=43200


# ─── 8) Chain sweeper (§43.2 · Treasury TRX · Phase1+) ───────────────────────
# TREASURY_TRX_BALANCE=5000
# SWEEPER_KEYS_HSM_REF=secret:sweeper-keys


# ─── 9) 시세 Adapters — Signup-Ready (Engine §0.0 · Day-1) ──────────────────
# Nest 로컬 ingest + CF Worker secrets 병행 · 채팅/GitHub 붙여넣기 금지

# eBay Browse — https://developer.ebay.com/
EBAY_CLIENT_ID=YOUR_EBAY_APP_ID
EBAY_CLIENT_SECRET=YOUR_EBAY_CERT_ID
EBAY_MARKETPLACE_BUY=EBAY_US
EBAY_MARKETPLACE_SELL=EBAY_GB
# Worker cron용 (쉼표 구분 · 미설정 시 US,GB)
# EBAY_MARKETPLACES=EBAY_US,EBAY_GB
# EBAY_SEARCH_QUERIES_JSON=["Rolex Submariner","Pokemon PSA 10"]

# Pokémon TCG — https://dev.pokemontcg.io/
POKEMONTCG_API_KEY=YOUR_POKEMONTCG_API_KEY
# POKEMONTCG_QUERIES_JSON=["name:charizard"]

# CoinGecko Demo — https://www.coingecko.com/en/api/pricing
COINGECKO_DEMO_API_KEY=YOUR_COINGECKO_DEMO_KEY

# Yu-Gi-Oh / Frankfurter — 키 불필요
# YGOPRODECK_BASE_URL=https://db.ygoprodeck.com/api/v7
# YGOPRODECK_NAMES_JSON=["Blue-Eyes White Dragon"]
# FRANKFURTER_BASE_URL=https://api.frankfurter.dev

# Nest ← Worker ingest (Phase1 CF deploy 시)
# NEST_ADAPTER_INGEST_URL=https://api.your-domain.com/api/v1/internal/adapters/ingest
ADAPTER_INGEST_TOKEN=change_me_adapter_ingest
# Money practice expire-tick · fail-closed (unset → Unauthorized, never open)
INTERNAL_WALLET_TICK_TOKEN=change_me_internal_wallet_tick


# ─── 10) Phase1+ Market Partners (Day-1 auto-publish 아님) ────────────────
# Amazon PA-API 5.0
# AMAZON_ACCESS_KEY=
# AMAZON_SECRET_KEY=
# AMAZON_PARTNER_TAG=
# AMAZON_MARKETPLACES=amazon_us
# AMAZON_SEARCH_QUERIES_JSON=["Rolex"]

# Yahoo! JAPAN Auction — Phase1+ official partner (v7.22.41)
# YAHOO_AUCTION_APP_ID=
# YAHOO_SEARCH_QUERIES_JSON=["ロレックス"]

# ─── 11) REL-020 Web Push (VAPID · 키는 tooling/pwa/generate-vapid.mjs) ──
# 실키는 .env.local / CF Workers Secrets. 여기 placeholder만.
PUSH_ENABLED=true
PUSH_DISPATCHER_URL=
PUSH_DISPATCH_TOKEN=change_me_push_dispatch
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:ops@localhost
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY

# ─── TRON / USDT-TRC20 (secrets local only · use pnpm tron:setup) ───────────
TRONGRID_API_KEY=YOUR_TRONGRID_API_KEY
TRONGRID_BASE_URL=https://api.trongrid.io
TATUM_MAINNET_API_KEY=YOUR_TATUM_MAINNET_API_KEY
TATUM_TESTNET_API_KEY=YOUR_TATUM_TESTNET_API_KEY
TATUM_KMS_SIGNATURE_ID=YOUR_TATUM_KMS_SIGNATURE_ID
TRON_HOT_WALLET_XPUB=YOUR_TRON_ACCOUNT_XPUB
TRON_TREASURY_ADDRESS=TYourTronLinkTreasuryAddress____________
# KMS password stays on founder PC only — never Render/GitHub
# TATUM_KMS_PASSWORD=
WALLET_TICK_SCHEDULER=1
WALLET_TICK_INTERVAL_MS=15000
