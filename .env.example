# Phase0 — copy to .env (never commit real secrets)
NODE_ENV=development
ROOT_DOMAIN=localhost

# Supabase = PostgreSQL SoT only (ADR-001)
# User Auth = api-nest JWT (ADR-006) — Supabase Auth 병행 금지
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_REGION=ap-northeast-2

# Dashboard → Settings → Database → URI (pooler / Seoul)
DATABASE_URL=postgresql://postgres.your-ref:YOUR_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# Redis hot cache — Upstash → Connect → Redis URL 만 붙여넣기 (.env 에만, 여기 X)
# redis-cli 명령 전체 붙여넣기 금지 · 예: rediss://default:********@xxxxx.upstash.io:6379
REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@YOUR-ENDPOINT.upstash.io:6379

# ─── Cloudflare (배포용 · .env 에만 · GitHub Actions secrets 병행) ─────────────
# Dashboard → Account → API Tokens → Edit Cloudflare Workers template
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
# 로컬 대안: pnpm cf:login (OAuth · 토큰 없이 wrangler 세션)

# Production hosts — prod deploy 시 필수 (local=localhost OK)
# ROOT_DOMAIN=your-domain.com
# APP_HOST=app.your-domain.com
# OPS_HOST=ops.your-domain.com
# API_HOST=api.your-domain.com
# GO_HOST=go.your-domain.com

APP_HOST=localhost:3000
OPS_HOST=localhost:3001
API_HOST=localhost:4000

JWT_USER_SECRET=change_me_user
JWT_ADMIN_SECRET=change_me_admin

# ─── 퍼뜩 LLM Adapter (Engine §47.13) ───────────────────────────────────────
# Day-1 클라우드 기본 = gemini_free (provider 1개만). 키는 .env 에만 · GitHub 0
# 발급: https://aistudio.google.com/apikey
# Adapter 미구현이어도 키만 보관 가능 · 런타임은 none과 같이 no-op
#
# LLM_PROVIDER=gemini_free|ollama|groq|openai|none
LLM_PROVIDER=none
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# 무료 티어: flash-lite-latest 권장 · gemini-2.0-flash 는 쿼터 429 잦음
GEMINI_MODEL=gemini-flash-lite-latest
# Soft quota (Nest+Redis) — 초과 시 G=PEOTTEOK_LLM_BUSY · P=Fact 유지
LLM_QUOTA_SOFT_RPM=10
LLM_QUOTA_SOFT_RPD=200
# ollama / groq / openai 교체 시만:
# LLM_BASE_URL=
# LLM_API_KEY=

# ─── Signup-Ready 시세 (Engine §0.0 · v7.22.32) ─────────────────────────────
# listing = ebay 멀티 marketplace + 카드/FX ± admin · yahoo_jp = 영구 FORBIDDEN
# 키는 이 파일(.env)에만 · 채팅/GitHub 붙여넣기 금지

# eBay Browse API — https://developer.ebay.com/ → Application Keys
# 승인까지 최대 ~1일 대기 가능
EBAY_CLIENT_ID=YOUR_EBAY_APP_ID
EBAY_CLIENT_SECRET=YOUR_EBAY_CERT_ID
# 기본 레그 (Browse marketplaceId)
EBAY_MARKETPLACE_BUY=EBAY_US
EBAY_MARKETPLACE_SELL=EBAY_GB

# CoinGecko Demo (무료) — https://www.coingecko.com/en/api/pricing → Demo
# 헤더: x-cg-demo-api-key · Pro URL 쓰지 말 것
COINGECKO_DEMO_API_KEY=YOUR_COINGECKO_DEMO_KEY

# Pokémon TCG — https://dev.pokemontcg.io/
POKEMONTCG_API_KEY=YOUR_POKEMONTCG_API_KEY

# Yu-Gi-Oh / Frankfurter — 키 불필요 (캐시만)
# YGOPRODECK_BASE_URL=https://db.ygoprodeck.com/api/v7
# FRANKFURTER_BASE_URL=https://api.frankfurter.dev

# Yahoo! JAPAN — 영구 배제 (v7.22.32) · YAHOO_* 슬롯 두지 말 것
