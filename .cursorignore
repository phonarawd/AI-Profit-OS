node_modules/
.next/
dist/
build/
target/
.turbo/
.wrangler/
.open-next/
coverage/
playwright-report/
test-results/
blob-report/
pnpm-lock.yaml
*.log
*.tsbuildinfo
.env
.git/

# ADR-016 — keep agent index thin on 8GB
**/pnpm-store/**
**/.pnpm-store/**

# ARCHIVE / audit bulk — human can open; agent index skip
.cursor/plans/ai_profit_os_launch_*.plan.md
CONSTITUTION/
PRE_IMPLEMENTATION_MASTER_AUDIT.md
COMPANY_REGISTRATION_SUMMARY.md
FOOTER_LICENSE_COPY.md
# NOTE: "docs/*" (not "docs/") -- gitignore semantics forbid re-including a file
# whose PARENT DIRECTORY is fully excluded, so a bare "docs/" would silently
# break the exception below. Keep the wildcard form so the negation works.
docs/*
# bootstrap SSOT exception for agents (must stay readable)
!docs/CONSTITUTION_BOOTSTRAP.md

# ADR-013 — photo mockups must not be indexed / reintroduced
docs/mockups/
**/mockup*.png
**/mockup*.jpg
assets/ai-profit-os-*.png
**/*-metal-hex*
