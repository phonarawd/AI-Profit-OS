{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/session-start.cjs",
        "timeout": 15
      }
    ],
    "beforeReadFile": [
      {
        "command": "node .cursor/hooks/project-boundary.mjs",
        "timeout": 30,
        "failClosed": true
      }
    ],
    "beforeTabFileRead": [
      {
        "command": "node .cursor/hooks/project-boundary.mjs",
        "timeout": 30,
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "node .cursor/hooks/project-boundary.mjs",
        "timeout": 30,
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/project-boundary.mjs",
        "timeout": 30,
        "failClosed": true
      },
      {
        "command": "node .cursor/hooks/before-shell-git-gate.cjs",
        "timeout": 120,
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "node .cursor/hooks/project-boundary.mjs",
        "timeout": 30,
        "failClosed": true
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/stop-cleanup.cjs",
        "timeout": 60
      }
    ],
    "sessionEnd": [
      {
        "command": "node .cursor/hooks/stop-cleanup.cjs",
        "timeout": 60
      }
    ]
  }
}
