{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node .cursor/hooks/project-boundary.mjs",
        "matcher": "^(Shell|Read|Write|Grep|Glob|Delete|StrReplace|EditNotebook|WebFetch|FetchMcpResource|CallMcpTool|MCP:)",
        "timeout": 20,
        "failClosed": true
      }
    ],
    "beforeTabFileRead": [
      {
        "command": "node .cursor/hooks/project-boundary.mjs",
        "timeout": 20,
        "failClosed": true
      }
    ]
  }
}
