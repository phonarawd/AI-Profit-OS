{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@aipo/ui/*": [
        "../../packages/ui/*"
      ],
      "@aipo/sdk/*": [
        "../../packages/sdk/src/*"
      ],
      "@aipo/schemas": [
        "../../packages/schemas/src/index.ts"
      ],
      "@aipo/schemas/*": [
        "../../packages/schemas/src/*"
      ],
      "@aipo/operator-entity": [
        "../../schemas/operator-entity.instance.json"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "../../schemas/operator-entity.instance.json"
  ],
  "exclude": [
    "node_modules",
    "**/*.runtime.test.ts"
  ]
}
