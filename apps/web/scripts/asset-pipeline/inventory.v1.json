{
  "schema": "asset-pipeline.inventory.v1",
  "rel": "REL-018",
  "standardEntry": "apps/web/scripts/asset-pipeline/run.mjs",
  "stages": ["source", "optimize", "hash", "public", "review_checklist"],
  "note": "아래 3개 애드혹 스크립트는 preserve/작업트리 패턴이다. origin/main에는 없다. Home 에셋을 재생성하지 않으므로 본 브랜치에 복사하지 않는다. 후속 화면 REL은 standardEntry만 사용한다.",
  "adhocScripts": [
    {
      "path": "apps/web/scripts/download-spark-dash-assets.mjs",
      "onCanonicalMain": false,
      "input": "Figma MCP asset URL map (expires ~7d)",
      "output": "apps/web/public/spark-dash/*",
      "failureModes": [
        "fetch !ok 시 continue (부분 실패 침묵)",
        "hash/검수 단계 없음",
        "Home 승인 에셋 덮어쓰기 가능"
      ],
      "successor": "apps/web/scripts/asset-pipeline/run.mjs",
      "homeSafe": false,
      "mustNotRerunAgainstHome": true
    },
    {
      "path": "apps/web/scripts/download-spark-dash-mobile-assets.mjs",
      "onCanonicalMain": false,
      "input": "Figma MCP mobile URL map + _tmp_spark_dash_refs",
      "output": "apps/web/public/spark-dash/mobile-* 및 tmp refs",
      "failureModes": [
        "fetch !ok 시 continue",
        "hash/검수 단계 없음",
        "desktop spark-dash를 덮지 않는다고 주석만 있고 강제 가드 없음"
      ],
      "successor": "apps/web/scripts/asset-pipeline/run.mjs",
      "homeSafe": false,
      "mustNotRerunAgainstHome": true
    },
    {
      "path": "apps/web/scripts/process-product-sneaker.mjs",
      "onCanonicalMain": false,
      "input": "apps/web/public/spark-dash/product-sneaker-source.png",
      "output": "apps/web/public/spark-dash/product-sneaker-hero.png",
      "failureModes": [
        "Playwright+canvas 로컬 의존",
        "Home ProductMedia 산출물을 직접 교체",
        "hash lock 없음"
      ],
      "successor": "apps/web/scripts/asset-pipeline/run.mjs",
      "homeSafe": false,
      "mustNotRerunAgainstHome": true
    }
  ],
  "partnerLogo": {
    "branch": "official-only",
    "aiGeneration": "HARD_FAIL",
    "existingSsot": "packages/ui/brand/assets/markets/manifest.json",
    "pipelineMustNotRegenerate": true
  },
  "emojiAsIcon": "FORBIDDEN"
}
