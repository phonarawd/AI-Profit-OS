{
  "version": 3,
  "rootDomain": "hiptk.app",
  "cloudflare": {
    "accountId": "190a1476a068cfe96dfe1029877587ef",
    "zoneId": "a8f07448b300cf7f0215a3bbb9cf705e",
    "zoneStatus": "active",
    "workersDevSubdomain": "ebay-adapter"
  },
  "env": {
    "ROOT_DOMAIN": "hiptk.app",
    "APP_HOST": "app.hiptk.app",
    "OPS_HOST": "ops.hiptk.app",
    "API_HOST": "api.hiptk.app",
    "GO_HOST": "go.hiptk.app"
  },
  "openNext": {
    "runtime": "workers",
    "forbiddenDeploy": [
      "wrangler pages deploy",
      "pages_build_output_dir",
      ".open-next/cloudflare as deploy root"
    ],
    "requiredArtifacts": [".open-next/worker.js", ".open-next/assets"],
    "web": {
      "worker": "ai-profit-web",
      "app": "apps/web",
      "wrangler": "infra/web/wrangler.toml",
      "workersDev": "ai-profit-web.ebay-adapter.workers.dev"
    },
    "ops": {
      "worker": "ai-profit-ops",
      "app": "apps/admin",
      "wrangler": "infra/ops/wrangler.toml",
      "workersDev": "ai-profit-ops.ebay-adapter.workers.dev"
    },
    "note": "OpenNext(@opennextjs/cloudflare) = Workers only. pages.dev 레거시 404 — 배포·프록시·스모크는 workersDev SSOT.",
    "staging": {
      "wranglerEnv": "preview",
      "deploy": "pnpm cf:deploy:staging",
      "forbiddenHosts": [
        "app.hiptk.app",
        "ops.hiptk.app",
        "api.hiptk.app",
        "hiptk.app",
        "go.hiptk.app"
      ],
      "web": {
        "worker": "ai-profit-web-preview",
        "workersDev": "ai-profit-web-preview.ebay-adapter.workers.dev"
      },
      "ops": {
        "worker": "ai-profit-ops-preview",
        "workersDev": "ai-profit-ops-preview.ebay-adapter.workers.dev"
      },
      "note": "REL-600 staging origin = wrangler [env.preview]. production workersDev/custom domain 불변. production workflow_dispatch 오용 금지."
    }
  },
  "pages": {
    "web": {
      "project": "ai-profit-web",
      "workersDev": "ai-profit-web.ebay-adapter.workers.dev",
      "pagesDev": "ai-profit-web.pages.dev",
      "note": "project 이름 유지 · origin SSOT = openNext.web.workersDev · pages.dev 사용 금지"
    },
    "ops": {
      "project": "ai-profit-ops",
      "workersDev": "ai-profit-ops.ebay-adapter.workers.dev",
      "pagesDev": "ai-profit-ops.pages.dev",
      "note": "project 이름 유지 · origin SSOT = openNext.ops.workersDev · pages.dev 사용 금지"
    }
  },
  "bridgeWorkers": {
    "web-proxy": {
      "worker": "hiptk-web-proxy",
      "path": "workers/web-proxy",
      "hostnames": ["app.hiptk.app", "hiptk.app", "go.hiptk.app"],
      "target": "https://ai-profit-web.ebay-adapter.workers.dev"
    },
    "ops-proxy": {
      "worker": "hiptk-ops-proxy",
      "path": "workers/ops-proxy",
      "hostnames": ["ops.hiptk.app"],
      "target": "https://ai-profit-ops.ebay-adapter.workers.dev"
    },
    "api-stub": {
      "worker": "hiptk-api-stub",
      "path": "workers/api-stub",
      "hostnames": ["api.hiptk.app"],
      "target": "https://ai-profit-os.onrender.com",
      "note": "Phase0 Nest on Render · workers/_shared/api-origin.ts SSOT · cloudflared 로컬 터널 폐기"
    }
  },
  "dns": {
    "provision": "Workers custom_domain (auto · Zone:DNS:Edit 불필요)",
    "deploy": "pnpm cf:domain:bridge"
  },
  "email": {
    "support": "support@hiptk.app",
    "fromDefault": "noreply@hiptk.app",
    "provider": "resend",
    "note": "Resend dashboard 도메인 검증 · RESEND_FROM_EMAIL + RESEND_API_KEY in .env"
  },
  "github": {
    "repository": "phonarawd/AI-Profit-OS",
    "environment": "production",
    "secretKeys": [
      "ROOT_DOMAIN",
      "APP_HOST",
      "OPS_HOST",
      "API_HOST",
      "CLOUDFLARE_API_TOKEN",
      "CLOUDFLARE_ACCOUNT_ID"
    ]
  }
}
