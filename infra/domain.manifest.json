{
  "version": 3,
  "rootDomain": "putduk.com",
  "cloudflare": {
    "accountId": "9dc502d4ef06b3b5374591de6e6933ca",
    "zoneId": "c9e6c93451c3c2e107a1eca511bedaba",
    "zoneStatus": "active",
    "workersDevSubdomain": "putduk"
  },
  "env": {
    "ROOT_DOMAIN": "putduk.com",
    "APP_HOST": "putduk.com",
    "OPS_HOST": "ops.putduk.com",
    "API_HOST": "api.putduk.com"
  },
  "bridgeWorkers": {
    "api-stub": {
      "worker": "hiptk-api-stub",
      "path": "workers/api-stub",
      "hostnames": ["api.putduk.com"],
      "target": "https://ai-profit-os.onrender.com",
      "note": "Phase0 Nest on Render · cloudflared 로컬 터널 폐기"
    }
  },
  "dns": {
    "provision": "Workers custom_domain (auto · Zone:DNS:Edit 불필요)",
    "deploy": "pnpm cf:domain:bridge"
  },
  "email": {
    "support": "support@putduk.com",
    "fromDefault": "noreply@putduk.com",
    "provider": "resend",
    "note": "Resend dashboard 도메인 검증 · RESEND_FROM_EMAIL + RESEND_API_KEY in .env"
  },
  "github": {
    "repository": "phonarawd/AI-Profit-OS",
    "environment": "production",
    "secretKeys": [
      "ROOT_DOMAIN",
      "APP_HOST",
      "OPS_HOST",
      "API_HOST",
      "CLOUDFLARE_API_TOKEN",
      "CLOUDFLARE_ACCOUNT_ID"
    ]
  },
  "forbiddenDeploy": [
    "wrangler pages deploy",
    "pages_build_output_dir",
    ".open-next/cloudflare as deploy root"
  ],
  "productionHosts": [
    "putduk.com",
    "ops.putduk.com",
    "api.putduk.com",
    "ai-profit-os.onrender.com"
  ],
  "customerWebHandoff": {
    "owner": "putduk-web"
  },
  "domainRoles": {
    "landingOnly": [],
    "userWeb": ["putduk.com", "www.putduk.com"],
    "userWebOwner": "putduk-web",
    "opsHost": "ops.putduk.com",
    "thisRepoHosts": ["api.putduk.com"],
    "thisRepoWorkers": ["hiptk-api-stub", "push-dispatcher"],
    "note": "putduk.com is the customer Mine OS origin. This repo deploys API/backend Workers only; customer web is owned by putduk-web."
  }
}