{
  "version": 3,
  "rootDomain": "hiptk.app",
  "cloudflare": {
    "accountId": "190a1476a068cfe96dfe1029877587ef",
    "zoneId": "a8f07448b300cf7f0215a3bbb9cf705e",
    "zoneStatus": "active",
    "workersDevSubdomain": "ebay-adapter"
  },
  "env": {
    "ROOT_DOMAIN": "hiptk.app",
    "APP_HOST": "app.hiptk.app",
    "OPS_HOST": "ops.hiptk.app",
    "API_HOST": "api.hiptk.app",
    "GO_HOST": "go.hiptk.app"
  },
  "bridgeWorkers": {
    "api-stub": {
      "worker": "hiptk-api-stub",
      "path": "workers/api-stub",
      "hostnames": [
        "api.hiptk.app"
      ],
      "target": "https://ai-profit-os.onrender.com",
      "note": "Phase0 Nest on Render · workers/_shared/api-origin.ts SSOT · cloudflared 로컬 터널 폐기"
    }
  },
  "dns": {
    "provision": "Workers custom_domain (auto · Zone:DNS:Edit 불필요)",
    "deploy": "pnpm cf:domain:bridge"
  },
  "email": {
    "support": "support@hiptk.app",
    "fromDefault": "noreply@hiptk.app",
    "provider": "resend",
    "note": "Resend dashboard 도메인 검증 · RESEND_FROM_EMAIL + RESEND_API_KEY in .env"
  },
  "github": {
    "repository": "phonarawd/AI-Profit-OS",
    "environment": "production",
    "secretKeys": [
      "ROOT_DOMAIN",
      "APP_HOST",
      "OPS_HOST",
      "API_HOST",
      "CLOUDFLARE_API_TOKEN",
      "CLOUDFLARE_ACCOUNT_ID"
    ]
  },
  "forbiddenDeploy": [
    "wrangler pages deploy",
    "pages_build_output_dir",
    ".open-next/cloudflare as deploy root"
  ],
  "productionHosts": [
    "app.hiptk.app",
    "ops.hiptk.app",
    "api.hiptk.app",
    "hiptk.app",
    "go.hiptk.app",
    "ai-profit-os.onrender.com"
  ],
  "customerWebHandoff": {
    "owner": "putduk-web",
    "restoreSha": "97b07908",
    "restore": "git checkout 97b07908 -- infra/web infra/ops workers/web-proxy workers/ops-proxy workers/_shared/opennext-origin.ts tooling/deploy/cf-pages-web.cjs tooling/deploy/cf-pages-ops.cjs"
  },
  "domainRoles": {
    "landingOnly": ["putduk.com"],
    "userWeb": ["hiptk.app", "app.hiptk.app"],
    "userWebOwner": "putduk-web",
    "opsHost": "ops.hiptk.app",
    "thisRepoHosts": ["api.hiptk.app"],
    "thisRepoWorkers": ["hiptk-api-stub", "push-dispatcher"],
    "note": "putduk.com is landing-only. Never treat as customer-app origin, CORS allowlist, cookie domain, or WebAuthn RP. User web origin is hiptk.app and app.hiptk.app (putduk-web). This repo deploys API stub / push-dispatcher / R2 / backend Workers only — no OpenNext, pages, or landing."
  }
}
