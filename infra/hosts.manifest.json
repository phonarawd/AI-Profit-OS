{
  "phase": 0,
  "domainManifest": "infra/domain.manifest.json",
  "rootDomain": "hiptk.app",
  "bus": "in-process",
  "forbiddenDay1": [
    "nats",
    "temporal",
    "eks",
    "vercel"
  ],
  "compose": {
    "file": "docker-compose.dev.yml",
    "required": false,
    "note": "ADR-016 Docker-less default — remote Supabase Seoul + Upstash"
  },
  "hosts": {
    "api": {
      "runtime": "node-nest",
      "service": "services/api-nest",
      "envHost": "API_HOST",
      "defaultPort": 4000,
      "manifest": "infra/api/runtime.json"
    },
    "db": {
      "provider": "supabase",
      "region": "ap-northeast-2",
      "projectRef": "mgsytcetsiecllmhcyox",
      "env": "DATABASE_URL",
      "authSoT": "nest-jwt-only"
    },
    "redis": {
      "provider": "upstash",
      "env": "REDIS_URL",
      "composeService": "redis",
      "composeRequired": false
    },
    "r2": {
      "bucket": "kyc-docs",
      "config": "infra/r2/kyc-docs.toml"
    }
  },
  "workersPhase0": [
    "push-dispatcher"
  ],
  "notes": "Runtime P0=$0 path · Nest API + Supabase Seoul + Upstash · customer web/ops hosts are DNS facts in domain.manifest.env · pages deploy/Vercel/NATS/Temporal/EKS=0"
}
