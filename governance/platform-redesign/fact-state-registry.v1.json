  "domainFsm": [
    {
      "fsmId": "engine.trade_execution",
      "ownerPlan": "02-engine",
      "states": [
        "running",
        "requeue",
        "success",
        "safe_stop",
        "failed"
      ],
      "terminalHints": {
        "success": "MATCH_SUCCESS → settlement journal",
        "safe_stop": "Soft60/Hard90/MATCH_TIMEOUT · recovery ≠ blocked view",
        "failed": "SYSTEM_FAILED → Nest write (rust emits SystemFailed)"
      },
      "rustNotOwner": {
        "statuses": ["cancelled"],
        "resultCodes": ["CANCELLED_BY_USER"],
        "owner": "nest-persist-schema",
        "ruleEngine": "rust-not-owner"
      },
      "separationRule": "commonViewStates에 합치지 않음 · UI는 viewState + domainFsm.status 이중 필드 · cancelled는 rust-not-owner"
    },
    {
      "fsmId": "auth.session",
      "ownerPlan": "06-infra",
      "states": [
        "guest",
        "authenticated",
        "expired"
      ],
      "separationRule": "expired→view unauthorized · guest 0값 Fact 위장 금지"
    }
  ],
  "reasonCode": {
    "grammar": "domain.resource.reason",
    "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
    "vocabularyStatus": "deferred_to_domain_phases",
    "note": "R0는 schema/grammar만 고정. blocked_policy 등 vocabulary는 Money/Engine domain Phase에서 registry 확정.",
    "examplesSchemaOnly": [
      "money.principal.insufficient",
      "money.kyc.required",
      "money.circuit.bucket_invariant",
      "auth.session.expired",
      "engine.opportunity.compare_not_ready",
      "engine.opportunity.price_stale",
      "engine.trade.match_blocked"
    ],
    "forbidden": [
      "underscore_flat_alias",
      "camelCase",
      "view_state_as_reason",
      "domain_fsm_state_as_reason"
    ]
  },
  "requiredFactMeta": [
    "source",
    "asOf",
    "freshness",
    "owner",
    "provenance"
  ],
  "semanticConflictProtection": [
    "provenance",
    "source",
    "freshness",
    "asOf",
    "state",
    "money_meaning",
    "auth_boundary",
    "engine_transition"
  ],
  "iterativeValidation": {
    "method": "Fact↔State mutual cross-check (non-linear · not Fact-first-100%)",
    "loop": [
      "Observe",
      "Classify",
      "Fact",
      "State",
      "Contract(deferred)"
    ],
    "rounds": [
      {
        "round": 1,
        "focus": "baseline_home_money_opportunity_growth",
        "factIdsTouched": [
          "money.wallet.principalUsdt",
          "money.home.settlementCompletedTodayCount",
          "engine.home.todayPossibleProfitUsdt",
          "growth.public.ledgerTotal",
          "engine.opportunity.expectedProfitUsdt"
        ],
        "stateFindings": [
          "Home fetch lifecycle이 commonViewStates로 노출되지 않음(loading/ready_* 혼선) → missing_fact/deferred",
          "guest/null pulse 고정 claim은 Fact가 아님 → defect 분류는 baseline·R1 owner"
        ],
        "result": "Money amount vs COUNT 단위 분리 잠금 · ledgerTotal=COUNT"
      },
      {
        "round": 2,
        "focus": "view_state_vs_domain_fsm_separation",
        "factIdsTouched": [
          "engine.trade.executionStatus",
          "auth.session.status"
        ],
        "stateFindings": [
          "running|requeue|success|safe_stop|failed ∈ engine.trade_execution · cancelled=rust-not-owner",
          "commonViewStates ∩ domainFsm.states = ∅ 검증",
          "safe_stop ≠ blocked(view) — recovery path 상이"
        ],
        "result": "이중 필드 규칙 고정 · reasonCode grammar만 R0 잠금"
      },
      {
        "round": 3,
        "focus": "cross_check_coverage",
        "factIdsTouched": [
          "engine.opportunity.assetImageUrl",
          "engine.opportunity.compareReady",
          "brand.mark.consumer",
          "money.wallet.profitUsdt"
        ],
        "stateFindings": [
          "모든 commonViewState가 ≥1 fact.allowedViewStates 또는 surfaceStateBindings에 소비됨",
          "모든 fact가 allowedViewStates⊆commonViewStates · domainFsmPointer 유효",
          "asOf/freshness/source/owner/provenance 5종 필수 충족"
        ],
        "result": "R0 registry freeze · Contract 작성은 R1 Product Contract owner"
      }
    ]
  },
