{
  "version": 1,
  "rel": "REL-403",
  "scheme": "semver",
  "packageJsonOwner": "package.json",
  "tagPrefix": "v",
  "tagPattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
  "releaseIdFormat": "{semver}+{gitSha7|local}",
  "releaseIdPattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\+([0-9a-f]{7}|local)$",
  "localSuffix": "local",
  "autoTagOnPush": false,
  "autoTagOnMain": false,
  "productionTag": "manual-after-human-deploy",
  "productionDeploy": "workflow_dispatch HUMAN",
  "envOverride": "PUTDUK_RELEASE_ID",
  "secret": false,
  "runtimeInjectionThisRel": false,
  "rollbackConsumer": "REL-602",
  "rollbackUses": "releaseId or annotated git tag as known-good"
}
