{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "react": ["../../apps/web/node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["../../apps/web/node_modules/@types/react/jsx-runtime.d.ts"],
      "react/jsx-dev-runtime": ["../../apps/web/node_modules/@types/react/jsx-dev-runtime.d.ts"]
    }
  },
  "include": ["components/**/*.ts", "components/**/*.tsx", "copy/**/*.ts"]
}
