{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": false,
    "paths": {
      "@aipo/ui/*": ["./*"],
      "@aipo/sdk/*": ["../sdk/src/*"],
      "@aipo/schemas": ["../schemas/src/index.ts"],
      "@aipo/schemas/*": ["../schemas/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "**/*.runtime.test.ts", "**/*.spec.ts", "**/*.spec.tsx"]
}
