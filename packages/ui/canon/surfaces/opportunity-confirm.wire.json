{
  "id": "opportunity-confirm",
  "route": "/profits/[id]",
  "state": "confirm",
  "brandRef": "packages/ui/brand",
  "primaryCta": { "copyKey": "T.execution.ctaEarn", "action": "participate" },
  "blocks": [
    {
      "id": "arbitrageTypeBadge",
      "role": "badge",
      "field": "arbitrageTypeKo",
      "note": "Engine §4.2a 투영 · UI type→ko 맵 금지"
    },
    {
      "id": "productThumb",
      "role": "media",
      "field": "assetImageUrl",
      "fallbackIconField": "assetIcon",
      "copyKey": "T.execution.imageRightsNote"
    },
    {
      "id": "priceCompareMargin",
      "role": "compare",
      "component": "PriceCompareMargin",
      "fields": [
        "buyPriceUsdt",
        "sellPriceUsdt",
        "expectedProfitUsdt",
        "platformMarginUsdt",
        "compareReady"
      ],
      "note": "Engine §0.0.4 pointer · UI 재계산 0 · 4면 중 confirm"
    },
    {
      "id": "disclaimer",
      "role": "disclaimer",
      "copyKey": "T.execution.disclaimerResult"
    },
    {
      "id": "precta",
      "role": "preflight",
      "component": "PreCTA",
      "copyKey": "T.loop.mayStop",
      "note": "UI §51.24.2 · mayStop 필수 · skip deeplink 0"
    },
    {
      "id": "cta",
      "role": "primary",
      "copyKey": "T.execution.ctaEarn",
      "requiresPreflightToken": true
    }
  ],
  "forbidden": [
    "buy_cta",
    "sell_cta",
    "recompute_margin",
    "execution_platforms_user",
    "expected_sell_days",
    "매입가",
    "판매가",
    "preflight_skip_deeplink",
    "무조건_성공",
    "gender_branch",
    "photo_pixel_match",
    "non_brand_logo"
  ]
}
