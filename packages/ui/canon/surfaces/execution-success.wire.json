{
  "id": "execution-success",
  "route": "/trades/[id]/execute",
  "brandRef": "packages/ui/brand",
  "primaryCta": {
    "copyKey": "T.successBucketCta.ctaProfitOnly",
    "href": "/wallet/withdraw?mode=profit"
  },
  "successBucketCtas": {
    "component": "SuccessBucketCtas",
    "count": 3,
    "emphasisDefault": "profit_withdraw",
    "items": [
      {
        "id": "profit",
        "copyKey": "T.successBucketCta.ctaProfitOnly",
        "href": "/wallet/withdraw?mode=profit"
      },
      {
        "id": "merge",
        "copyKey": "T.successBucketCta.ctaMerge",
        "action": "profit_merge"
      },
      {
        "id": "later",
        "copyKey": "T.successBucketCta.ctaLater",
        "action": "dismiss"
      }
    ]
  },
  "blocks": [
    {
      "id": "badge",
      "role": "badge",
      "copyKey": "T.execution.settledBadge"
    },
    {
      "id": "productThumb",
      "role": "media",
      "field": "assetImageUrl",
      "fallbackIconField": "assetIcon",
      "copyKey": "T.execution.imageRightsNote",
      "note": "same SKU image as running · §48.3a"
    },
    {
      "id": "priceCompareMargin",
      "role": "compare",
      "component": "PriceCompareMargin",
      "fields": [
        "buyPriceUsdt",
        "sellPriceUsdt",
        "expectedProfitUsdt",
        "platformMarginUsdt",
        "compareReady"
      ],
      "note": "Engine §0.0.4 pointer · UI 재계산 0 · 4면 중 receipt/success"
    },
    {
      "id": "productLabel",
      "role": "label",
      "field": "assetLabel"
    },
    {
      "id": "amount",
      "role": "amount",
      "copyKey": "T.execution.profitAmount"
    },
    {
      "id": "trust",
      "role": "badge",
      "copyKey": "T.execution.noBidBadge"
    },
    {
      "id": "successLegLog",
      "role": "log",
      "copyKey": "T.trust.partners.successLegLog",
      "note": "UI §38.10 · {buyLabel} ↔ {sellLabel} 시세 반영 · 「○○ 판매 완료」금지"
    },
    {
      "id": "share",
      "role": "secondary",
      "copyKey": "T.execution.shareBoast"
    },
    {
      "id": "bucketCtas",
      "role": "cta-row",
      "component": "SuccessBucketCtas",
      "copyKeys": [
        "T.successBucketCta.ctaProfitOnly",
        "T.successBucketCta.ctaMerge",
        "T.successBucketCta.ctaLater"
      ]
    },
    {
      "id": "tabs",
      "role": "tabbar",
      "copyKey": "T.ia.fiveTabs"
    }
  ],
  "forbidden": [
    "wrong_tabbar",
    "success_rate_percent",
    "gender_branch",
    "photo_pixel_match",
    "non_brand_logo",
    "user_sold_copy",
    "cross_category_image",
    "emoji_only_product_row",
    "missing_success_3cta"
  ]
}
