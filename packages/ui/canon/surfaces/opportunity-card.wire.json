{
  "id": "opportunity-card",
  "route": "/",
  "aliases": ["/profits"],
  "brandRef": "packages/ui/brand",
  "primaryCta": { "copyKey": "T.execution.ctaEarn", "action": "participate" },
  "cardHierarchy": [
    "opportunity",
    "requiredCapital",
    "expectedProfit",
    "aiConfidence",
    "ctaEarn"
  ],
  "blocks": [
    {
      "id": "badgeMatchable",
      "role": "badge",
      "copyKey": "T.opportunity.badgeMatchable"
    },
    {
      "id": "arbitrageTypeBadge",
      "role": "badge",
      "field": "arbitrageTypeKo",
      "note": "Engine §4.2a 투영 · UI type→ko 맵 금지"
    },
    {
      "id": "corridor",
      "role": "heading",
      "copyKey": "T.opportunity.corridor",
      "note": "arbitrageTypeKo from Engine §4.2a · UI map 금지"
    },
    {
      "id": "productThumb",
      "role": "media",
      "field": "assetImageUrl",
      "fallbackIconField": "assetIcon",
      "copyKey": "T.execution.imageRightsNote",
      "note": "Engine §0.0.6 · UI §48.3a · SKU 1:1 실물 썸네일"
    },
    {
      "id": "assetLabel",
      "role": "label",
      "field": "assetLabel",
      "note": "보조 · 상품 쇼핑 Hero 금지"
    },
    {
      "id": "requiredCapital",
      "role": "metric",
      "copyKey": "T.opportunity.labelRequiredCapital",
      "field": "requiredCapitalUsdt"
    },
    {
      "id": "expectedProfit",
      "role": "metric",
      "copyKey": "T.opportunity.labelExpectedProfit",
      "field": "expectedProfitUsdt"
    },
    {
      "id": "aiConfidence",
      "role": "metric",
      "copyKey": "T.opportunity.labelAiConfidence",
      "field": "aiConfidenceScore"
    },
    {
      "id": "partnerLeg",
      "role": "leg",
      "component": "MarketPartnerLeg",
      "copyKey": "T.trust.partners.legCaption",
      "copyKeyFootnote": "T.trust.partners.legFootnote",
      "note": "UI §38.10 · PriceCompareMargin 위 · logo status=ready only"
    },
    {
      "id": "priceCompareLow",
      "role": "compare",
      "copyKey": "T.opportunity.labelPriceLow",
      "field": "buyPriceUsdt",
      "note": "Engine §4.2b · 저가 시세 · 매입가 금지"
    },
    {
      "id": "priceCompareHigh",
      "role": "compare",
      "copyKey": "T.opportunity.labelPriceHigh",
      "field": "sellPriceUsdt",
      "note": "Engine §4.2b · 고가 시세 · 판매가 금지"
    },
    {
      "id": "priceCompareMargin",
      "role": "compare",
      "component": "PriceCompareMargin",
      "fields": [
        "buyPriceUsdt",
        "sellPriceUsdt",
        "expectedProfitUsdt",
        "platformMarginUsdt",
        "compareReady"
      ],
      "note": "Engine §0.0.4 pointer · UI 재계산 0 · 4면 중 home/card"
    },
    {
      "id": "badgeNoBuy",
      "role": "badge",
      "copyKey": "T.execution.badgeNoBuy"
    },
    {
      "id": "badgeNoSell",
      "role": "badge",
      "copyKey": "T.execution.badgeNoSell"
    },
    {
      "id": "disclaimer",
      "role": "disclaimer",
      "copyKey": "T.execution.disclaimerResult"
    },
    {
      "id": "cta",
      "role": "primary",
      "copyKey": "T.execution.ctaEarn"
    }
  ],
  "forbidden": [
    "buy_cta",
    "sell_cta",
    "bid_cta",
    "expected_sell_days",
    "labelExpectedTurn_user_slot",
    "execution_platforms_user",
    "product_cta_이_상품으로",
    "구매하기",
    "판매하기",
    "입찰하기",
    "마켓_둘러보기",
    "거래하기_primary",
    "매칭_참여_as_primary",
    "참여하기_sticky",
    "gender_branch",
    "success_rate_percent",
    "sell_success_rate_user",
    "매입가",
    "판매가",
    "photo_pixel_match",
    "non_brand_logo"
  ]
}
