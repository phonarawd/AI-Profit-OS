{
  "id": "execution-safe-stop",
  "route": "/trades/[id]/execute",
  "brandRef": "packages/ui/brand",
  "primaryCta": { "copyKey": "T.execution.browseOther", "href": "/profits" },
  "blocks": [
    { "id": "title", "role": "heading", "copyKey": "T.execution.safeStopTitle" },
    {
      "id": "matchTimeout",
      "role": "heading",
      "copyKey": "T.execution.matchTimeout",
      "when": "result=MATCH_TIMEOUT",
      "note": "Hard wall · 카피③ 우선 · 잔액 불변"
    },
    { "id": "reason", "role": "body", "copyKey": "T.execution.safeStopReason" },
    {
      "id": "priceNearMiss",
      "role": "body",
      "copyKey": "T.execution.priceNearMiss",
      "when": "result=PRICE_MOVED",
      "note": "§48.3b 아깝게 실패"
    },
    { "id": "balance", "role": "note", "copyKey": "T.execution.balanceUnchanged" },
    {
      "id": "participateProof",
      "role": "proof",
      "component": "ParticipateProofPanel",
      "copyKey": "T.trust.proof.title",
      "note": "UI §51.16 · 참여할 때 본 조건"
    },
    {
      "id": "recommend",
      "role": "list",
      "copyKey": "T.execution.recommendCards",
      "itemMediaField": "assetImageUrl",
      "note": "§48.3a category-matched thumb on recommend card"
    }
  ],
  "forbidden": [
    "MATCH_FAILURE_english",
    "success_rate_percent",
    "gender_branch",
    "photo_pixel_match",
    "non_brand_logo",
    "ledger_debit_on_stop",
    "cross_category_image",
    "IT_timeout_SLA_user"
  ]
}
