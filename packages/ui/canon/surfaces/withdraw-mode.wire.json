{
  "id": "withdraw-mode",
  "route": "/wallet/withdraw",
  "brandRef": "packages/ui/brand",
  "defaultMode": "profit",
  "primaryCta": {
    "copyKey": "T.withdrawMode.ctaProfitWithdraw",
    "href": "/wallet/withdraw?mode=profit"
  },
  "blocks": [
    {
      "id": "modeCards",
      "role": "segment",
      "component": "WithdrawModeCards",
      "defaultMode": "profit",
      "modes": ["profit", "principal"]
    },
    {
      "id": "principalSheet",
      "role": "sheet",
      "component": "PrincipalConfirmSheet",
      "copyKeys": [
        "T.withdrawMode.confirmTitle",
        "T.withdrawMode.confirmBody",
        "T.withdrawMode.ctaProfitOnly",
        "T.withdrawMode.ctaStillPrincipal"
      ],
      "requiredForModes": ["principal", "combined"]
    }
  ],
  "forbidden": [
    "default_mode_principal",
    "principal_withdraw_hidden",
    "forfeit_threat_copy",
    "gender_branch",
    "photo_pixel_match"
  ]
}
