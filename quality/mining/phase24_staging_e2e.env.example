# MINE-024 / PHASE21 staging mutation E2E variable-name template.
# DO NOT place real secrets or Production identifiers in this file.
# Mutation mode stays disabled unless PHASE21_ALLOW_MUTATION_E2E=YES is supplied out-of-repo.

PHASE21_E2E_MODE=preflight
PHASE21_ALLOW_MUTATION_E2E=NO
PHASE21_ALLOW_TRIAL_RESIDUE=NO

PHASE21_API_BASE_URL=https://REPLACE-WITH-ISOLATED-STAGING-API.example
PHASE21_EXPECTED_API_HOST=REPLACE-WITH-ISOLATED-STAGING-HOST
PHASE21_EXPECTED_BACKEND_SHA=REPLACE_WITH_EXACT_40_CHAR_STAGING_SHA
PHASE21_EXPECTED_STAGING_SUPABASE_REF=REPLACE_WITH_NON_PRODUCTION_20_CHAR_REF

PHASE21_INTERNAL_MINING_TOKEN=SET_OUT_OF_REPO
JWT_ADMIN_SECRET=SET_OUT_OF_REPO
JWT_USER_SECRET=SET_OUT_OF_REPO
PHASE06_MAKER_ADMIN_ID=SET_DEDICATED_STAGING_UUID
PHASE06_CHECKER_ADMIN_ID=SET_DIFFERENT_DEDICATED_STAGING_UUID
PHASE21_USER_ID=SET_DEDICATED_STAGING_UUID
