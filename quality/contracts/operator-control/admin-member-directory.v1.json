{
  "contractVersion": "2026-09-15.p4.member-directory-v2",
  "kind": "operator_member_directory",
  "implementation": "exact_uuid_reuse_plus_isolated_persist_page",
  "activation": {
    "exactUuidLookup": "implemented_reuses_getMembership",
    "paginatedList": "isolated_persist_when_ready",
