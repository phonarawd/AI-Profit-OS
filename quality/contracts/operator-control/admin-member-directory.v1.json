        "cursor": "optional"
      },
      "guard": "AdminGuard",
      "capability": {
        "name": "users",
        "level": "read"
      },
      "csrf": "not_required_for_GET"
    },
    {
      "method": "GET",
      "path": "/api/v1/admin/users/:id/membership",
      "note": "existing detail · not replaced by /me/membership"
    }
  ],
  "errors": [
