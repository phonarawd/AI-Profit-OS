{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-profit-os.local/schemas/auth-session.v1.json",
  "title": "AuthSessionV1",
  "description": "Infra §51.9 Nest JWT session only · Supabase Auth FORBIDDEN.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sessionId",
    "userId",
    "issuer",
    "issuedAt",
    "expiresAt",
    "revoked"
  ],
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "userId": {
      "type": "string",
      "minLength": 1
    },
    "issuer": {
      "type": "string",
      "const": "ai-profit-os-nest",
      "description": "Nest JWT issuer · not Supabase Auth"
    },
    "deviceId": {
      "type": "string"
    },
    "deviceLabel": {
      "type": "string"
    },
    "ip": {
      "type": "string"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp"
    },
    "revoked": {
      "type": "boolean"
    },
    "revokedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp"
    },
    "refreshJti": {
      "type": "string"
    }
  }
}
