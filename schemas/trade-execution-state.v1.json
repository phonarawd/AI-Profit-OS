{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-profit-os.local/schemas/trade-execution-state.v1.json",
  "title": "TradeExecutionStateV1",
  "description": "§48 step/result · includes MATCH_TIMEOUT. NEVER: RNG→MATCH_SUCCESS · presentation timer credits ledger.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tradeId",
    "opportunityId",
    "pricingVersion",
    "status",
    "stepIndex",
    "progressPct",
    "expectedProfitUsdt",
    "asset"
  ],
  "properties": {
    "tradeId": {
      "type": "string",
      "minLength": 1
    },
    "opportunityId": {
      "type": "string",
      "minLength": 1
    },
    "pricingVersion": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "requeue",
        "success",
        "safe_stop",
        "cancelled",
        "failed"
      ]
    },
    "resultCode": {
      "type": "string",
      "enum": [
        "MATCH_SUCCESS",
        "REQUEUE",
        "PRICE_MOVED",
        "BELOW_MIN_PROFIT",
        "CANCELLED_BY_USER",
        "CIRCUIT_OPEN",
        "SYSTEM_FAILED",
        "MATCH_TIMEOUT"
      ]
    },
    "stepIndex": {
      "type": "integer",
      "enum": [
        0,
        1,
        2,
        3,
        4
      ]
    },
    "progressPct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "logLine": {
      "type": "string"
    },
    "expectedProfitUsdt": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "description": "Decimal as string (no float money)"
    },
    "settledProfitUsdt": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "description": "Decimal as string (no float money)"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "iconUrl": {
          "type": "string",
          "format": "uri"
        },
        "ref": {
          "type": "string"
        }
      }
    }
  }
}
