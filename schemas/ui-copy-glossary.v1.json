      {
        "code": "MATCH_SUCCESS",
        "koLabel": "조건이 맞았어요",
        "surface": "user"
      },
      {
        "code": "Margin",
        "koLabel": "내 수익",
        "surface": "user",
        "forbiddenAliases": [
          "Margin",
          "마진",
          "ROI",
          "PnL"
        ]
      },
      {
        "code": "Arbitrage",
        "koLabel": "시세차익",
        "surface": "user",
        "forbiddenAliases": [
          "Arbitrage",
          "아비트라지"
        ]
      }
    ]
  }
}
