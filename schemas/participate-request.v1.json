{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-profit-os.local/schemas/participate-request.v1.json",
  "title": "ParticipateRequestV1",
  "description": "Engine §48.13.1 POST body · pricingVersion + minProfitUsdt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "opportunityId",
    "pricingVersion",
    "minProfitUsdt",
    "amountUsdt",
    "idempotencyKey"
  ],
  "properties": {
    "opportunityId": {
      "type": "string",
      "minLength": 1
    },
    "pricingVersion": {
      "type": "integer",
      "minimum": 1
    },
    "minProfitUsdt": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "description": "Decimal as string (no float money)"
    },
    "amountUsdt": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "description": "Decimal as string (no float money)"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8
    }
  }
}
