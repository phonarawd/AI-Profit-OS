{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-profit-os.local/schemas/user-deposit-address.v1.json",
  "title": "UserDepositAddressV1",
  "description": "§41 per-user TRC20. NEVER: admin manual address edit · shared address.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "userId",
    "trc20Address",
    "derivationIndex",
    "qrPayload",
    "createdAt"
  ],
  "properties": {
    "userId": {
      "type": "string",
      "minLength": 1
    },
    "trc20Address": {
      "type": "string",
      "minLength": 30
    },
    "derivationIndex": {
      "type": "integer",
      "minimum": 0
    },
    "qrPayload": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp"
    },
    "lastSeenTxAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp"
    }
  }
}
