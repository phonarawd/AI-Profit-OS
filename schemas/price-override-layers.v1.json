{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-profit-os.local/schemas/price-override-layers.v1.json",
  "title": "PriceOverrideLayersV1",
  "description": "REL-407 frozen 4 price layers. SOURCE_OBSERVED ≠ OVERRIDE ≠ EFFECTIVE ≠ USER_VISIBLE. User screens read EFFECTIVE only. NEVER: 5th layer · listing in-place overwrite · ledger credit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "layers", "reasonCodes"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "layers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "string",
        "enum": [
          "SOURCE_OBSERVED",
          "OVERRIDE",
          "EFFECTIVE",
          "USER_VISIBLE"
        ]
      }
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "string",
        "enum": [
          "SOURCE_STALE",
          "FEED_GAP",
          "MANUAL_COMMERCIAL",
          "RISK_ADJUST",
          "OVERRIDE_CLEAR"
        ]
      }
    }
  },
  "default": {
    "version": 1,
    "layers": [
      "SOURCE_OBSERVED",
      "OVERRIDE",
      "EFFECTIVE",
      "USER_VISIBLE"
    ],
    "reasonCodes": [
      "SOURCE_STALE",
      "FEED_GAP",
      "MANUAL_COMMERCIAL",
      "RISK_ADJUST",
      "OVERRIDE_CLEAR"
    ]
  }
}
