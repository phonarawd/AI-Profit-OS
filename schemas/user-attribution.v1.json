{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-profit-os.local/schemas/user-attribution.v1.json",
  "title": "UserAttributionV1",
  "description": "Infra §31 · CAPI attribution. NEVER: CAPI before consent · fingerprint ads · PII raw to CAPI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "userId",
    "firstTouch",
    "lastTouch",
    "consentMarketing",
    "consentAt",
    "capiSentEvents"
  ],
  "properties": {
    "userId": {
      "type": "string",
      "minLength": 1
    },
    "firstTouch": {
      "$ref": "#/$defs/Touch"
    },
    "lastTouch": {
      "$ref": "#/$defs/Touch"
    },
    "consentMarketing": {
      "type": "boolean"
    },
    "consentAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp"
    },
    "firstDepositAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp"
    },
    "firstDepositUsdt": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "description": "Decimal as string (no float money)"
    },
    "capiSentEvents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "Touch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "landingVariant"
      ],
      "properties": {
        "utmSource": {
          "type": "string"
        },
        "utmMedium": {
          "type": "string"
        },
        "utmCampaign": {
          "type": "string"
        },
        "utmContent": {
          "type": "string"
        },
        "utmTerm": {
          "type": "string"
        },
        "gclid": {
          "type": "string"
        },
        "fbclid": {
          "type": "string"
        },
        "ttclid": {
          "type": "string"
        },
        "landingVariant": {
          "type": "string"
        }
      }
    }
  }
}
