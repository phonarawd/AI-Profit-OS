{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-profit-os.local/schemas/user-capability.v1.json",
  "title": "UserCapabilityV1",
  "description": "Admin §9.8.4a · matchBlocked · withdrawApplyBlocked. NEVER: silent block · ledger-as-block.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "userId",
    "matchBlocked",
    "withdrawApplyBlocked"
  ],
  "properties": {
    "userId": {
      "type": "string",
      "minLength": 1
    },
    "matchBlocked": {
      "type": "boolean"
    },
    "withdrawApplyBlocked": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "minLength": 10,
      "description": "Required ≥10 when enabling a block"
    },
    "updatedByAdminId": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp"
    }
  }
}
