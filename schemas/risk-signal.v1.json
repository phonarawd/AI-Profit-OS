{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-profit-os.local/schemas/risk-signal.v1.json",
  "title": "RiskSignalV1",
  "description": "Money §49.9 P1~P24 · E1~E12 signal · Admin risk?tab=queue row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "ruleCode",
    "severity",
    "queueStatus",
    "freezeLinked",
    "createdAt"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "userId": { "type": ["string", "null"], "format": "uuid" },
    "ruleCode": {
      "type": "string",
      "pattern": "^(P([1-9]|1[0-9]|2[0-4])|E([1-9]|1[0-2]))$"
    },
    "severity": {
      "type": "string",
      "enum": ["info", "warn", "high", "p0"]
    },
    "queueStatus": {
      "type": "string",
      "enum": ["open", "acked", "resolved", "auto_frozen"]
    },
    "detail": { "type": "object" },
    "freezeLinked": { "type": "boolean" },
    "createdAt": { "type": "string", "format": "date-time" },
    "resolvedAt": { "type": ["string", "null"], "format": "date-time" }
  }
}
