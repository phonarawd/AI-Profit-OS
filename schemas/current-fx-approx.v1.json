{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-profit-os.local/schemas/current-fx-approx.v1.json",
  "title": "CurrentFxApproxV1",
  "description": "REL-508 POST /api/v1/me/current-fx/approx · DISPLAY_ONLY. Server approxKrwFromSnapshot only. Missing snapshot/amount → null. NEVER fabricate 0 KRW. NEVER client Number()*rate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fxSnapshotId",
    "capturedAt",
    "principalKrwApprox",
    "withdrawableProfitKrwApprox",
    "expectedProfitKrwApprox",
    "krwDisplayAvailable",
    "fxStatus",
    "quotes",
    "budget"
  ],
  "properties": {
    "fxSnapshotId": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "capturedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "principalKrwApprox": {
      "type": ["string", "null"],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "withdrawableProfitKrwApprox": {
      "type": ["string", "null"],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "expectedProfitKrwApprox": {
      "type": ["string", "null"],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "krwDisplayAvailable": {
      "type": "boolean"
    },
    "fxStatus": {
      "type": "string",
      "enum": ["FRESH", "STALE", "UNAVAILABLE"]
    },
    "quotes": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "amountUsdt", "amountKrw"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "amountUsdt": {
            "type": ["string", "null"],
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "amountKrw": {
            "type": ["string", "null"],
            "pattern": "^-?[0-9]+$"
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "estimatedMonthlyCalls", "monthlyLimit", "level"],
      "properties": {
        "plan": { "type": "string", "const": "FREE_DEMO" },
        "estimatedMonthlyCalls": { "type": "integer", "minimum": 1 },
        "monthlyLimit": { "type": "integer", "minimum": 1 },
        "level": { "type": "string", "enum": ["NORMAL", "WARNING", "CRITICAL"] }
      }
    }
  }
}
