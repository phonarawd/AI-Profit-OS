{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-profit-os.local/schemas/current-fx-approx.v1.json",
  "title": "CurrentFxApproxV1",
  "description": "REL-508 POST /api/v1/me/current-fx/approx · DISPLAY_ONLY. Server approxKrwFromSnapshot only. Missing snapshot/amount → null. NEVER fabricate 0 KRW. NEVER client Number()*rate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fxSnapshotId",
    "capturedAt",
    "principalKrwApprox",
    "withdrawableProfitKrwApprox",
    "expectedProfitKrwApprox"
  ],
  "properties": {
    "fxSnapshotId": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "capturedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "principalKrwApprox": {
      "type": ["string", "null"],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "withdrawableProfitKrwApprox": {
      "type": ["string", "null"],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "expectedProfitKrwApprox": {
      "type": ["string", "null"],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    }
  }
}
