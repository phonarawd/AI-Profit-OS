{
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "javascript.validate.enable": true,
  "typescript.validate.enable": true,
  "js/ts.implicitProjectConfig.checkJs": false,
  "typescript.disableAutomaticTypeAcquisition": true,
  "typescript.tsserver.maxTsServerMemory": 1024,
  "typescript.tsserver.watchOptions": {
    "watchFile": "useFsEvents",
    "watchDirectory": "useFsEvents",
    "fallbackPolling": "priorityInterval",
    "synchronousWatchDirectory": false
  },
  "typescript.surveys.enabled": false,

  "editor.formatOnSave": true,
  "editor.minimap.enabled": false,
  "editor.smoothScrolling": false,
  "editor.cursorSmoothCaretAnimation": "off",
  "editor.bracketPairColorization.enabled": false,
  "editor.guides.indentation": false,
  "editor.hover.delay": 600,
  "editor.quickSuggestionsDelay": 150,
  "editor.renderWhitespace": "none",
  "editor.linkedEditing": false,
  "diffEditor.maxComputationTime": 2000,
  "files.eol": "\n",
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 2000,
  "files.maxMemoryForLargeFilesMB": 256,
  "npm.packageManager": "pnpm",
  "npm.autoDetect": "off",
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": false,
  "git.autofetch": false,
  "git.decorations.enabled": false,
  "git.blame.editorDecoration.enabled": false,
  "search.followSymlinks": false,
  "search.smartCase": true,
  "breadcrumbs.enabled": false,
  "workbench.enableExperiments": false,
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 6,
  "workbench.editor.limit.perEditorGroup": true,
  "workbench.startupEditor": "none",
  "telemetry.telemetryLevel": "off",
  "problems.decorations.enabled": false,

  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false,
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    }
  },
  "[mdc]": {
    "editor.formatOnSave": false
  },

  "files.associations": {
    "*.mdc": "markdown",
    "*.plan.md": "markdown"
  },

  "eslint.enable": false,
  "eslint.workingDirectories": [{ "mode": "auto" }],

  "markdownlint.run": "onSave",
  "markdownlint.configFile": "${workspaceFolder}/.markdownlint.json",
  "markdownlint.appliesTo": "workspaceFiles",
  "markdownlint.lintWorkspaceGlobs": [
    "**/*.{md,markdown}",
    "!**/node_modules/**",
    "!**/.git/**",
    "!${userHome}/.cursor/plans/**",
    "!.cursor/plans/**",
    "!**/.cursor/plans/**",
    "!.cursor/rules/**",
    "!**/*.plan.md",
    "!**/*.mdc",
    "!docs/**",
    "!CONSTITUTION/**",
    "!PRE_IMPLEMENTATION_MASTER_AUDIT.md",
    "!COMPANY_REGISTRATION_SUMMARY.md",
    "!FOOTER_LICENSE_COPY.md",
    "!AGENTS.md",
    "!TOOLCHAIN.md",
    "!**/CATALOG.md",
    "!**/CONSTITUTION_BOOTSTRAP.md",
    "!**/ADR-*.md"
  ],

  "rust-analyzer.initializeStopped": true,
  "rust-analyzer.checkOnSave": false,
  "rust-analyzer.cargo.buildScripts.enable": false,
  "rust-analyzer.procMacro.enable": false,
  "rust-analyzer.files.exclude": [
    ".git",
    "node_modules",
    "target",
    ".next",
    "dist"
  ],

  "tailwindCSS.files.exclude": [
    "**/.git/**",
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/target/**",
    "**/.cursor/**",
    "**/CONSTITUTION/**"
  ],

  "files.watcherExclude": {
    "**/.worktrees/**": true,
    "**/_wt_*/**": true,
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/dist/**": true,
    "**/target/**": true,
    "**/.turbo/**": true,
    "**/.wrangler/**": true,
    "**/coverage/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/playwright-report/**": true,
    "**/test-results/**": true,
    "**/.open-next/**": true,
    "**/pnpm-lock.yaml": true,
    "**/CONSTITUTION/**": true,
    "**/.cursor/plans/**": true,
    "**/.tools/**": true,
    "**/docs/**": true
  },
  "search.exclude": {
    "**/.worktrees": true,
    "**/_wt_*": true,
    "**/node_modules": true,
    "**/target": true,
    "**/.next": true,
    "**/dist": true,
    "**/.turbo": true,
    "**/.wrangler": true,
    "**/coverage": true,
    "**/playwright-report": true,
    "**/test-results": true,
    "**/.open-next": true,
    "**/pnpm-lock.yaml": true,
    "**/CONSTITUTION": true,
    "**/docs": true,
    "**/.tools": true
  },
  "files.exclude": {
    "**/.worktrees": true,
    "**/_wt_*": true,
    "**/node_modules": true,
    "**/.next": true,
    "**/dist": true,
    "**/target": true,
    "**/.wrangler": true,
    "**/coverage": true,
    "**/.turbo": true,
    "**/.open-next": true,
    "**/playwright-report": true,
    "**/test-results": true
  }
}
